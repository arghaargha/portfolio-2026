# Contact form email backend
# Create this API key in Resend, then add it locally as .env.local
# and in your hosting provider's environment variables.
RESEND_API_KEY=

# Public site base URL (used for sitemap metadata).
# Example: https://antarachakraborty.in
NEXT_PUBLIC_SITE_URL=

# The inbox that receives portfolio contact form messages.
CONTACT_TO_EMAIL=antarachakraborty030@gmail.com

# Use a verified Resend sender for production, for example:
# CONTACT_FROM_EMAIL=Antara Chakraborty Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=Antara Chakraborty Portfolio <onboarding@resend.dev>

# Set to true only for local/backend smoke tests without actually sending email.
CONTACT_DRY_RUN=false
